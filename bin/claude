#!/usr/bin/env bash
# ccwork wrapper for the `claude` CLI.
#
# Responsibility: inside the ccwork GUI (CCWORK_GUI=1), run the real
# `claude` with the user's args, untouched, as a child, and send a
# ClaudeExited event when it returns. Claude Code sends no
# SessionEnd hook for /exit (anthropics/claude-code#17885), so this is how
# the row learns that the session is over while the shell stays open.

set -u

# Locate the real claude binary. $PATH contains our bin/ first; skip ourselves.
_self=$(readlink -f "${BASH_SOURCE[0]}")
_real=$(type -ap claude 2>/dev/null | while read -r p; do
    [ "$(readlink -f "$p")" != "$_self" ] && { printf '%s\n' "$p"; break; }
done)
if [ -z "${_real:-}" ]; then
    printf 'ccwork: no real `claude` found on PATH (only this wrapper)\n' >&2
    exit 1
fi

# Outside the GUI there is nobody to tell. A `claude` started from inside a
# session (a tool call, a subagent shell) is not the row's session either:
# hand over to it untouched and send nothing.
if [ "${CCWORK_GUI:-0}" != "1" ] || [ -n "${CCWORK_CLAUDE_DEPTH:-}" ]; then
    exec "$_real" "$@"
fi
export CCWORK_CLAUDE_DEPTH=1

. "$(dirname "$_self")/ccwork-lib.sh"

# Run claude as a child so we see it exit — any way it exits, /exit included.
# Ctrl+C and Ctrl+Z reach claude through the terminal's foreground process
# group; this script only waits.
"$_real" "$@"
_code=$?
# Best-effort send: a dead GUI must never change claude's exit code.
_line="{\"event\":\"ClaudeExited\",\"row\":\"$(ccwork_json_escape "${CCWORK_ROW_ID:-}")\",\"cwd\":\"$(ccwork_json_escape "$PWD")\",\"ts\":$(date +%s),\"payload\":{\"code\":$_code}}"
ccwork_send "$_line" 2>/dev/null || true
exit "$_code"
