#!/usr/bin/env bash
# ccwork wrapper: renames the zellij tab, runs a spinner, and resumes the last conversation.
[ -n "$ZELLIJ" ] && zellij action rename-tab "$(basename "$PWD")"
_self=$(readlink -f "${BASH_SOURCE[0]}")
_real=$(type -ap claude 2>/dev/null | grep -Fxv "$_self" | head -1)
[ -z "$_real" ] && { echo "ccwork: claude not found in PATH" >&2; exit 1; }
if [ -n "$ZELLIJ" ]; then
    # Kill any leftover spinner from a previous run in this pane
    _pid_file="/tmp/ccwork-spinner-${ZELLIJ_PANE_ID}.pid"
    [ -f "$_pid_file" ] && kill "$(cat "$_pid_file")" 2>/dev/null
    # Start spinner — self-exits when claude (pid=$$) exits for any reason
    _claude_pid=$$
    _tab_name="$(basename "$PWD")"
    (
        _frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
        _i=0
        while kill -0 "$_claude_pid" 2>/dev/null; do
            zellij action rename-tab "${_frames:$((_i % ${#_frames})):1} ${_tab_name}"
            _i=$((_i + 1))
            sleep 0.15
        done
    ) &
    echo $! > "$_pid_file"
    disown $!
    _project_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(echo "$PWD" | sed 's|/|-|g')"
    if ls "$_project_dir"/*.jsonl 2>/dev/null | grep -q .; then
        exec "$_real" --continue "$@"
    fi
fi
exec "$_real" "$@"
