# ccwork-bashrc — bash rcfile shim used by ccwork's xterm sessions.
#
# Invoked via `bash --rcfile <this> -i`. Sources the user's normal
# interactive init, then re-prepends ccwork/bin to PATH so the `claude`
# wrapper wins over any later PATH manipulation in the user's dotfiles.
# Without this, a user .bashrc that exports PATH after the ccwork block
# (or doesn't have one at all) bypasses the wrapper, and the GUI doesn't
# get its RepoAdded ping for unregistered git roots.

[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"

# This file lives in <ccwork>/bin/, so its directory is what we want on PATH.
_ccwork_bin=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)
if [ -n "$_ccwork_bin" ]; then
    export PATH="$_ccwork_bin:$PATH"
fi
unset _ccwork_bin

# ccwork "Launch" (crash-recovery resume): the GUI sets CCWORK_RESUME_CMD
# when the user clicks Launch on the splash banner. Present it HERE — at the
# tail of init, after /etc/bash.bashrc and the user's ~/.bashrc have already
# printed — so the banner isn't buried in shell-startup output. Then seed the
# command into history so a single Up-arrow + Enter runs it. We do not
# auto-run: the user stays in control.
if [ -n "${CCWORK_RESUME_CMD:-}" ]; then
    printf '\n══════════════════════════════════════════════\n'
    printf "  HERE'S YOUR COMMAND TO CONTINUE TO WORK:\n\n"
    printf '      %s\n\n' "$CCWORK_RESUME_CMD"
    printf '  (press ↑ then Enter to run it)\n'
    printf '══════════════════════════════════════════════\n\n'
    history -s "$CCWORK_RESUME_CMD"
    unset CCWORK_RESUME_CMD
fi
