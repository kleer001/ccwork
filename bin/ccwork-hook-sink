#!/usr/bin/env bash
# ccwork-hook-sink — Claude Code Stop/Notification hook → ccwork GUI.
#
# Reads the hook payload from stdin, wraps it as
#   {"event":"$CCWORK_EVENT","cwd":"$PWD","ts":<epoch>,"payload":<stdin>}
# and writes one newline-terminated line to the ccwork Unix socket.
#
# The event type is passed through $CCWORK_EVENT (set via the hooks config).
# Defaults to "Unknown" so a misconfigured hook still logs something useful.
#
# The GUI may not be running — writing silently fails in that case (by
# design: hooks must never break the user's claude session). socat exits
# non-zero but stdin of the hook is already drained, so Claude Code moves on.

set -u

# Gate: only fire when claude is running inside the ccwork GUI. Without this,
# every claude invocation from any terminal would ping the socket and pop
# desktop notifications. CCWORK_GUI=1 is exported by ccwork's terminal_session.
if [ "${CCWORK_GUI:-0}" != "1" ]; then
    cat >/dev/null  # drain stdin so claude doesn't block
    exit 0
fi

_sock_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}/ccwork"
_sock="$_sock_dir/ccwork.sock"
_event="${CCWORK_EVENT:-Unknown}"
_ts=$(date +%s)
_cwd="${CLAUDE_PROJECT_DIR:-$PWD}"

# Drain stdin. Claude Code provides a small JSON object per hook call.
_payload=$(cat)
# Default to null if caller gave us nothing; keeps the line valid JSON.
[ -z "$_payload" ] && _payload="null"
# Strip a single trailing newline from the payload (command substitution
# already does this, but be explicit). Any embedded newlines inside a JSON
# string are already escaped by the producer (Claude Code) as \n, so
# $_payload is safe to embed as-is.
_payload=${_payload%$'\n'}

# Escape strings for JSON in bash: handle \, ", and the C0 controls that
# can legitimately appear in a filesystem path (newline, CR, tab). Anything
# else below 0x20 is extremely rare; if a path contains it, the server will
# drop the line as malformed JSON (acceptable degradation).
_json_escape() {
    local s=$1
    s=${s//\\/\\\\}          # \  → \\
    s=${s//\"/\\\"}          # "  → \"
    s=${s//$'\n'/\\n}        # LF → \n
    s=${s//$'\r'/\\r}        # CR → \r
    s=${s//$'\t'/\\t}        # TAB → \t
    printf '%s' "$s"
}
_cwd_esc=$(_json_escape "$_cwd")
_event_esc=$(_json_escape "$_event")

_line="{\"event\":\"$_event_esc\",\"cwd\":\"$_cwd_esc\",\"ts\":$_ts,\"payload\":$_payload}"

# Best-effort send. Short timeout so a dead socket doesn't stall Claude Code.
if command -v socat >/dev/null 2>&1; then
    printf '%s\n' "$_line" | timeout 1 socat - "UNIX-CONNECT:$_sock" >/dev/null 2>&1 || true
elif command -v nc >/dev/null 2>&1; then
    # nc -UN: UNIX + don't wait for server close.
    printf '%s\n' "$_line" | timeout 1 nc -UN "$_sock" >/dev/null 2>&1 \
        || printf '%s\n' "$_line" | timeout 1 nc -U "$_sock" >/dev/null 2>&1 \
        || true
fi

# Desktop notification — fires regardless of whether the GUI window is
# visible, focused, or even running. Catches the case where you're on
# another workspace or the window is buried.
#
# Honors the "desktop_notifications" toggle in ccwork's settings.toml.
# We grep for the key directly — it's unique across the file, so we don't
# need a section-aware parser. The legacy settings.json key uses a colon
# instead of an equals sign; we cover both shapes for the brief window
# before the GUI completes migration.
_cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ccwork"
_notify_disabled=0
for _f in "$_cfg_dir/settings.toml" "$_cfg_dir/settings.json"; do
    if [ -r "$_f" ] && \
       grep -Eq 'desktop_notifications[[:space:]]*[:=][[:space:]]*false' "$_f"; then
        _notify_disabled=1
        break
    fi
done

if [ "$_notify_disabled" = "0" ] && command -v notify-send >/dev/null 2>&1; then
    _repo=$(basename "$_cwd")
    case "$_event" in
        Notification) notify-send -u critical "Claude [$_repo]" "Needs your input" >/dev/null 2>&1 || true ;;
        Stop)         notify-send -u critical "Claude [$_repo]" "Task done"        >/dev/null 2>&1 || true ;;
    esac
fi

exit 0
