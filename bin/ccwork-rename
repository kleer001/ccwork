#!/usr/bin/env bash
# ccwork-rename — set the title (and optionally the badge emoji) of the
# ccwork sidebar row this terminal belongs to.
#
#   ccwork-rename "fix login bug"           set the title
#   ccwork-rename --badge 🐛 "fix login"    set the title and the badge
#   ccwork-rename --badge 🐛                set only the badge
#   ccwork-rename ""                        clear the title
#   ccwork-rename --badge ""                clear the badge
#
# Sends one RowRenamed event to the ccwork socket. Unlike the hook sink,
# this is a command you run on purpose, so it fails loudly outside ccwork.

set -u

_usage() {
    printf 'usage: ccwork-rename [--badge <emoji>] [<title>]\n' >&2
    exit 1
}

if [ "${CCWORK_GUI:-0}" != "1" ] || [ -z "${CCWORK_ROW_ID:-}" ]; then
    printf 'ccwork-rename: not inside a ccwork terminal (CCWORK_GUI / CCWORK_ROW_ID unset)\n' >&2
    exit 1
fi

. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ccwork-lib.sh"

_fields=""
if [ "${1:-}" = "--badge" ]; then
    [ $# -ge 2 ] || _usage
    _fields=",\"emoji\":\"$(ccwork_json_escape "$2")\""
    shift 2
fi
if [ $# -eq 1 ]; then
    _fields="$_fields,\"title\":\"$(ccwork_json_escape "$1")\""
elif [ $# -gt 1 ] || [ -z "$_fields" ]; then
    _usage
fi

if [ ! -S "$CCWORK_SOCK" ]; then
    printf 'ccwork-rename: ccwork socket not found at %s\n' "$CCWORK_SOCK" >&2
    exit 1
fi

_line="{\"event\":\"RowRenamed\",\"row\":\"$(ccwork_json_escape "$CCWORK_ROW_ID")\",\"ts\":$(date +%s),\"payload\":{${_fields#,}}}"
if ! ccwork_send "$_line"; then
    printf 'ccwork-rename: cannot reach the ccwork socket (needs socat or nc)\n' >&2
    exit 1
fi
